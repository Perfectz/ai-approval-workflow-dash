      "to": "audio",
      "label": "script approved",
      "role": "main",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "audio-boards",
      "from": "audio",
      "to": "boards",
      "label": "timing OK",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "boards-blender",
      "from": "boards",
      "to": "blender",
      "label": "approved",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "blender-package",
      "from": "blender",
      "to": "package",
      "label": "approved",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "package-spend",
      "from": "package",
      "to": "spend",
      "label": "ready for approval",
      "role": "main",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "spend-wan",
      "from": "spend",
      "to": "wan",
      "label": "authorized",
      "role": "main",
      "variant": "security"
    },
    {
      "id": "wan-takes",
      "from": "wan",
      "to": "takes",
      "label": "take saved",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "takes-edit",
      "from": "takes",
      "to": "edit",
      "label": "accepted",
      "role": "main",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Timing and grounding",
      "items": [
        "Read stages 01-12 in order. Target 15s; packages are 2-15 whole seconds at 30 fps. Scenes may span packages.",
        "Measure rendered audio. Preserve overruns; revise timing before slicing.",
        "Pair clean input images with labeled boards and stable character IDs."
      ]
    },
    {
      "dot": "amber",
      "title": "Generation and delivery",
      "items": [
        "Submit once, save the provider task ID, then poll that same task.",
        "Record exact requests, settings, reference versions, takes and cost.",
        "Deliver video, captions, audio stems, prompts and the decision archive."
      ]
    },
    {
      "dot": "emerald",
      "title": "Available in the local studio",
      "items": [
        "Project records, artifact versions, reviews and prompt/media views.",
        "Scratch-audio timing, rough cuts and shared agent CLI/MCP tools.",
        "Validated Wan package export; external creation tools provide assets."
      ]
    },
    {
      "dot": "rose",
      "title": "Production integrations still to connect",
      "items": [
        "Automatic Blender scene creation and rendering.",
        "Reference hosting and paid Wan API execution.",
        "Final mastered-film rendering. This diagram describes the target flow."
      ]
    }
  ],
